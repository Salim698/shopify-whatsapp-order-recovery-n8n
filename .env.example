# ---- Green API (WhatsApp) : console.green-api.com ----
# URL de votre instance, par exemple https://1234.api.greenapi.com (sans / final)
GREEN_API_URL=https://XXXX.api.greenapi.com
GREEN_API_INSTANCE=your_instance_id
GREEN_API_TOKEN=your_api_token

# ---- Google Gemini : Google AI Studio ----
GEMINI_API_KEY=your_gemini_api_key

# ---- Administrateur (reçoit les alertes) ----
# Format international sans + ni espaces, par exemple 22670000000
ADMIN_PHONE=22600000000

# ---- Code promo de la relance finale ----
PROMO_CODE=YOURCODE10
